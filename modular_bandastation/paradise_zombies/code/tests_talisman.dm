/** Only client/ghost possession is substituted; production target, ownership, timer and mind checks remain active. */
/obj/item/plague_talisman/unit_test/return_soul(mob/living/carbon/human/victim)
	return !isnull(victim.mind)

/** Living, synthetic and soulless targets must fail before a ritual reserves or changes the corpse. */
/datum/unit_test/paradise_plague_talisman_boundaries/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	caster.mind_initialize()
	victim.mind_initialize()
	var/obj/item/plague_talisman/unit_test/test_talisman = allocate(/obj/item/plague_talisman/unit_test)
	TEST_ASSERT(caster.put_in_hands(test_talisman), "The caster could not hold the ritual artifact.")
	TEST_ASSERT(!test_talisman.raise_victim(victim, caster), "A living victim was accepted for necromancy.")
	victim.death()
	var/obj/item/plague_talisman/real_talisman = allocate(/obj/item/plague_talisman)
	TEST_ASSERT(caster.put_in_hands(real_talisman), "The caster could not hold the second ritual artifact.")
	TEST_ASSERT(!real_talisman.raise_victim(victim, caster), "A clientless corpse without a returning ghost was accepted as an inhabited target.")
	TEST_ASSERT_NULL(real_talisman.ritual_timer, "A rejected soulless target left a conversion timer running.")
	victim.set_species(/datum/species/ipc)
	TEST_ASSERT(!test_talisman.raise_victim(victim, caster), "An IPC was accepted by flesh-only plague magic.")

/** The real five-second timer must produce a single-use, immune, 200-health servant bound to its caster. */
/datum/unit_test/paradise_plague_talisman_ritual/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	caster.mind_initialize()
	victim.mind_initialize()
	victim.apply_status_effect(/datum/status_effect/paradise_cloning_damage, 50)
	victim.death()
	var/obj/item/plague_talisman/unit_test/talisman = allocate(/obj/item/plague_talisman/unit_test)
	talisman.chosen_plague = /datum/disease/dna_retrovirus/paradise_plague
	TEST_ASSERT(caster.put_in_hands(talisman), "The caster could not hold the ritual artifact.")
	var/started_at = world.time
	TEST_ASSERT(talisman.raise_victim(victim, caster), "A valid inhabited corpse did not start the ritual.")
	TEST_ASSERT(HAS_TRAIT(victim, TRAIT_PARADISE_PLAGUE_ZOMBIE) && HAS_TRAIT(victim, TRAIT_PARADISE_NON_INFECTIOUS_ZOMBIE), "The ritual did not immediately bestow its plague traits.")
	var/datum/disease/paradise_zombie/wizard/infection = locate() in victim.diseases
	TEST_ASSERT(istype(infection), "The ritual did not immediately install the uncureable wizard plague subtype.")
	TEST_ASSERT_EQUAL(victim.maxHealth, 50, "The ritual granted its final health bonus or prematurely healed cellular injury before the five-second binding.")
	TEST_ASSERT_NULL(victim.mind.has_antag_datum(/datum/antagonist/wizard_minion/paradise_plague_zombie), "The servant was bound to its master before the five-second delay.")
	var/datum/component/paradise_zombie_regen/regeneration = victim.GetComponent(/datum/component/paradise_zombie_regen)
	TEST_ASSERT_NOTNULL(regeneration, "The immediate plague transformation did not install regeneration.")
	TEST_ASSERT(victim.revive(), "The ritual fixture could not revive before its delayed master binding.")
	TEST_ASSERT_NOTEQUAL(victim.stat, DEAD, "The plague could not resurrect its victim while the ritual was still pending.")
	UNTIL(QDELETED(talisman) || world.time >= started_at + 10 SECONDS)
	TEST_ASSERT(QDELETED(talisman), "The conversion timer did not finish and consume the talisman.")
	TEST_ASSERT(world.time >= started_at + 5 SECONDS, "The ritual completed before the original five-second delay.")
	TEST_ASSERT_NOTEQUAL(victim.stat, DEAD, "The completed ritual left its servant dead.")
	TEST_ASSERT_EQUAL(victim.maxHealth, 200, "The plague servant did not receive its original two-hundred-health body.")
	TEST_ASSERT_EQUAL(victim.health, 200, "The plague servant did not finish with a full two hundred health.")
	TEST_ASSERT_NULL(victim.has_status_effect(/datum/status_effect/paradise_cloning_damage), "The completed ritual left its Lazarus corpse's cellular injury active.")
	TEST_ASSERT_EQUAL(infection.plague_disease, /datum/disease/dna_retrovirus/paradise_plague, "The chosen plague did not reach the zombie's infection and claws.")
	var/datum/antagonist/wizard_minion/paradise_plague_zombie/servant = victim.mind.has_antag_datum(/datum/antagonist/wizard_minion/paradise_plague_zombie)
	TEST_ASSERT_NOTNULL(servant, "The raised body was not bound through the native wizard-minion system.")
	TEST_ASSERT_EQUAL(servant.master_ref?.resolve(), caster.mind, "The servant was bound to the wrong character.")
	TEST_ASSERT_EQUAL(victim.mind.enslaved_to?.resolve(), caster, "The native creator bond did not identify the necromancer.")
	var/datum/disease/dna_retrovirus/paradise_plague/exposure = allocate(/datum/disease/dna_retrovirus/paradise_plague)
	TEST_ASSERT(!caster.CanContractDisease(exposure) && !victim.CanContractDisease(exposure), "The wizard or servant can contract its own bestowed plague.")
	var/obj/item/storage/belt/plague_talisman/belt = allocate(/obj/item/storage/belt/plague_talisman)
	TEST_ASSERT_EQUAL(length(belt.contents), 5, "The runic belt did not create five usable talismans.")
	for(var/obj/item/content as anything in belt.contents)
		TEST_ASSERT(istype(content, /obj/item/plague_talisman), "The runic belt contains an unrelated item instead of a talisman.")
	infection.cure()
	TEST_ASSERT(infection in victim.diseases, "Ordinary disease cure removed an anti-magic-only wizard plague.")
	qdel(infection)
	TEST_ASSERT_NULL(locate(/datum/disease/paradise_zombie) in victim.diseases, "Force-clearing the plague left its wizard disease installed.")
	TEST_ASSERT(!HAS_TRAIT(victim, TRAIT_PARADISE_PLAGUE_ZOMBIE) && !HAS_TRAIT(victim, TRAIT_PARADISE_NON_INFECTIOUS_ZOMBIE), "Force-clearing the plague left variant flags behind.")
	TEST_ASSERT(!HAS_TRAIT_FROM(victim, TRAIT_VIRUSIMMUNE, PARADISE_ZOMBIE_TRAIT), "Force-clearing the plague left the servant's granted immunity behind.")
	TEST_ASSERT_NULL(victim.mind.has_antag_datum(/datum/antagonist/wizard_minion/paradise_plague_zombie), "Force-clearing the plague left its necromancy servant bond installed.")
	TEST_ASSERT_NULL(victim.mind.enslaved_to, "Force-clearing the plague left its native creator bond behind.")
	TEST_ASSERT(HAS_TRAIT_FROM(caster, TRAIT_VIRUSIMMUNE, MAGIC_TRAIT), "Clearing a servant removed the caster's permanent gift of immunity.")

/** A second talisman cannot reserve the same corpse, and a changed soul invalidates the delayed conversion. */
/datum/unit_test/paradise_plague_talisman_identity_and_duplicates/Run()
	var/mob/living/carbon/human/caster = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/victim = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/new_body = allocate(/mob/living/carbon/human/consistent)
	caster.mind_initialize()
	victim.mind_initialize()
	victim.death()
	var/obj/item/plague_talisman/unit_test/first = allocate(/obj/item/plague_talisman/unit_test)
	var/obj/item/plague_talisman/unit_test/second = allocate(/obj/item/plague_talisman/unit_test)
	TEST_ASSERT(caster.put_in_hands(first) && caster.put_in_hands(second), "The caster could not hold the two competing artifacts.")
	TEST_ASSERT(first.raise_victim(victim, caster), "The first artifact did not reserve the target.")
	TEST_ASSERT(!second.raise_victim(victim, caster), "Two artifacts began converting the same corpse concurrently.")
	victim.mind.transfer_to(new_body)
	var/deadline = world.time + 10 SECONDS
	UNTIL(!first.ritual_timer || world.time >= deadline)
	TEST_ASSERT_NULL(first.ritual_timer, "The invalidated conversion timer did not release its reservation.")
	TEST_ASSERT(QDELETED(first), "An artifact which already bestowed its plague was refunded after an identity change.")
	TEST_ASSERT(HAS_TRAIT(victim, TRAIT_PARADISE_PLAGUE_ZOMBIE), "Invalidating the delayed master binding reversed the already-bestowed plague.")
	TEST_ASSERT_NULL(new_body.mind.has_antag_datum(/datum/antagonist/wizard_minion/paradise_plague_zombie), "The ritual enslaved a soul which had moved to another body.")
	new_body.death()
	TEST_ASSERT(second.raise_victim(new_body, caster), "The unused competing artifact could not begin a ritual on a different corpse.")
	qdel(second)
	TEST_ASSERT(HAS_TRAIT(new_body, TRAIT_PARADISE_PLAGUE_ZOMBIE), "Deleting a spent artifact reversed its already-bestowed plague.")
	TEST_ASSERT_NULL(new_body.mind.has_antag_datum(/datum/antagonist/wizard_minion/paradise_plague_zombie), "Deleting the ritual artifact nevertheless bound the unfinished servant.")
