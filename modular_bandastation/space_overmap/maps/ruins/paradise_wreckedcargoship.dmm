"Pu" = (
/obj/item/paper{
	name = "полевой журнал: Разграбленный грузовой корабль";
	 default_raw_text = "Объект: Разграбленный грузовой корабль. Отмечены следы длительного отсутствия обслуживания. Сохранность груза и оборудования не подтверждена. Перед вскрытием отсеков проверить атмосферу; найденные материалы и носители сохранить вместе с местом обнаружения."
	},
