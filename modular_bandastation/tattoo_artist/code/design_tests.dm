/// A client cannot supply ink outside the limb or turn transparent cells into a visible rectangle.
/datum/unit_test/drawn_tattoo_pixels/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = subject.get_bodypart(BODY_ZONE_L_ARM)
	var/datum/tattoo_design/design = allocate(/datum/tattoo_design)
	var/list/palette = list("#ff0000", "#0000ff")
	var/blank = repeat_string(4096, "0")
	TEST_ASSERT(!design.prepare(arm, SOUTH, blank, palette), "Empty art was accepted.")
	TEST_ASSERT(!design.prepare(arm, SOUTH, "1", palette), "A truncated canvas was accepted.")
	TEST_ASSERT(!design.prepare(arm, SOUTH, splicetext(blank, 1, 2, "1"), palette), "Ink in the empty top-left corner was accepted.")

	// Base human front-view left upper arm includes (22,18). Its top-left detail sample is (43,36).
	var/index = (64 - 36) * 64 + 43
	var/art = splicetext(blank, index, index + 2, "12")
	art = splicetext(art, index + 64, index + 65, "2")
	TEST_ASSERT(!design.prepare(arm, NORTHEAST, art, palette), "A diagonal surface was accepted.")
	TEST_ASSERT(!design.prepare(arm, NORTH, art, palette), "The front arm mask was used for the reverse side.")
	TEST_ASSERT(!design.prepare(arm, SOUTH, art, list("#ff0000")), "A missing palette entry was accepted.")
	TEST_ASSERT(!design.prepare(arm, SOUTH, art, list("garbage", "#0000ff")), "An invalid color was accepted.")
	TEST_ASSERT(!design.prepare(arm, SOUTH, splicetext(art, index, index + 1, "g"), palette), "A non-hex ink index was accepted.")
	TEST_ASSERT(design.prepare(arm, SOUTH, art, palette), "Valid pixel art was rejected.")
	TEST_ASSERT_EQUAL(lowertext(design.detail_icon.GetPixel(43, 36)), "#ff0000", "The top-left detail cell changed color.")
	TEST_ASSERT_EQUAL(lowertext(design.detail_icon.GetPixel(43, 35)), "#0000ff", "The artwork was flipped vertically.")
	TEST_ASSERT_EQUAL(lowertext(design.world_icon.GetPixel(22, 18, "", SOUTH)), "#0000ff", "Three detail samples were reduced to the wrong world ink.")
	for(var/direction in list(NORTH, EAST, WEST))
		TEST_ASSERT(!design.world_icon.GetPixel(22, 18, "", direction), "A tattoo appeared on another side.")

/// Clothing, limb replacement and the bodypart cache must keep each original with its physical limb.
/datum/unit_test/drawn_tattoo_limb/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/recipient = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = subject.get_bodypart(BODY_ZONE_L_ARM)
	var/obj/item/bodypart/other_arm = recipient.get_bodypart(BODY_ZONE_L_ARM)
	var/datum/tattoo_design/design = allocate(/datum/tattoo_design)
	var/blank = repeat_string(4096, "0")
	var/index = (64 - 36) * 64 + 43
	var/art = splicetext(blank, index, index + 1, "1")
	var/ink = "#7f00f2"
	TEST_ASSERT(design.prepare(arm, SOUTH, art, list(ink)), "Single-pixel drawing did not prepare.")
	var/initial_key = arm.get_cache_key()
	subject.setDir(SOUTH)
	var/icon/plain_front = getFlatIcon(subject, defdir = SOUTH, no_anim = TRUE)
	var/icon/plain_back = getFlatIcon(subject, defdir = NORTH, no_anim = TRUE)
	TEST_ASSERT(!other_arm.apply_drawn_tattoo(design), "A replacement arm accepted a design prepared for another limb.")
	var/obj/item/clothing/under/uniform = allocate(/obj/item/clothing/under/color/grey)
	TEST_ASSERT(subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_ICLOTHING), "Could not cover the arm with a uniform.")
	TEST_ASSERT(!arm.tattoo_is_exposed() && !arm.apply_drawn_tattoo(design), "A sleeved arm accepted a tattoo.")
	subject.dropItemToGround(uniform, force = TRUE)
	TEST_ASSERT(arm.apply_drawn_tattoo(design), "The uncovered arm did not receive the tattoo.")
	TEST_ASSERT(!arm.apply_drawn_tattoo(design), "Overlapping submissions applied twice.")
	TEST_ASSERT(arm.has_drawn_tattoo(SOUTH) && !arm.has_drawn_tattoo(NORTH), "One tattoo occupied multiple sides of the limb.")
	TEST_ASSERT(arm.get_cache_key() != initial_key, "The tattoo reused the unmarked limb's appearance cache.")
	TEST_ASSERT_EQUAL(lowertext(design.world_icon.GetPixel(22, 18, "", SOUTH)), ink, "Single-sample ink vanished during reduction.")
	var/icon/tattooed_front = getFlatIcon(subject, defdir = SOUTH, no_anim = TRUE)
	var/icon/tattooed_back = getFlatIcon(subject, defdir = NORTH, no_anim = TRUE)
	TEST_ASSERT(plain_front.GetPixel(22, 18) != tattooed_front.GetPixel(22, 18), "The world sprite did not change at the selected point.")
	TEST_ASSERT_EQUAL(lowertext(tattooed_front.GetPixel(22, 18)), ink, "The applied mark did not reach the player's visible sprite.")
	TEST_ASSERT_EQUAL(tattooed_front.GetPixel(22, 15), plain_front.GetPixel(22, 15), "The mark also appeared at the vertically mirrored point.")
	TEST_ASSERT_EQUAL(icon2base64(tattooed_back), icon2base64(plain_back), "The front tattoo changed the appearance of the back.")

	var/list/details = subject.examine_more(subject)
	TEST_ASSERT(findtext(jointext(details, ""), design.examine_image_url), "The owner could not inspect the original.")
	recipient.forceMove(get_step(subject, EAST))
	var/list/gallery = subject.get_visible_drawn_tattoos(recipient)
	TEST_ASSERT_EQUAL(length(gallery), 1, "A nearby observer could not see the tattoo in the examine tab.")
	var/list/entry = gallery[1]
	TEST_ASSERT_EQUAL(entry["image"], design.examine_image_url, "The tab did not show the original crop.")
	TEST_ASSERT_EQUAL(entry["zone"], ru_parse_zone(BODY_ZONE_L_ARM), "The tab mislabeled the marked arm.")
	TEST_ASSERT_EQUAL(entry["side"], "вид спереди", "The tab mislabeled the front view.")
	recipient.forceMove(get_step(recipient, EAST))
	TEST_ASSERT(!length(subject.get_visible_drawn_tattoos(recipient)), "Moving out of reach left the tattoo in the tab.")
	recipient.forceMove(get_step(subject, EAST))
	recipient.become_blind(TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT(!length(subject.get_visible_drawn_tattoos(recipient)), "A blind observer received the visual design.")
	recipient.cure_blind(TRAIT_SOURCE_UNIT_TESTS)
	subject.equip_to_slot_if_possible(uniform, ITEM_SLOT_ICLOTHING)
	var/icon/covered_front = getFlatIcon(subject, defdir = SOUTH, no_anim = TRUE)
	TEST_ASSERT(lowertext(covered_front.GetPixel(22, 18)) != ink, "The ink appeared on top of a uniform sleeve.")
	details = subject.examine_more(subject)
	TEST_ASSERT(!findtext(jointext(details, ""), design.examine_image_url), "A sleeve exposed the full-size art on examine.")
	TEST_ASSERT(!length(subject.get_visible_drawn_tattoos(recipient)), "The tab exposed ink under the uniform.")
	uniform.toggle_jumpsuit_adjust()
	subject.update_worn_undersuit()
	TEST_ASSERT(arm.tattoo_is_exposed(), "Rolling down a standard jumpsuit failed to uncover the arm.")
	var/icon/rolled_front = getFlatIcon(subject, defdir = SOUTH, no_anim = TRUE)
	TEST_ASSERT_EQUAL(lowertext(rolled_front.GetPixel(22, 18)), ink, "The pixel remained hidden after rolling down the jumpsuit.")
	subject.dropItemToGround(uniform, force = TRUE)
	arm.drop_limb(special = TRUE)
	details = subject.examine_more(subject)
	TEST_ASSERT(!findtext(jointext(details, ""), design.examine_image_url), "The old owner kept the tattoo after limb removal.")
	TEST_ASSERT(!length(subject.get_visible_drawn_tattoos(subject)), "The tab retained a detached arm's drawing.")
	other_arm.drop_limb(special = TRUE)
	TEST_ASSERT(arm.try_attach_limb(recipient, special = TRUE), "Could not attach the original limb to a second human.")
	details = recipient.examine_more(recipient)
	TEST_ASSERT(findtext(jointext(details, ""), design.examine_image_url), "The new owner did not inherit the drawing on the limb.")
	gallery = recipient.get_visible_drawn_tattoos(recipient)
	TEST_ASSERT_EQUAL(length(gallery), 1, "The new owner's tab is missing the transplanted tattoo.")
	var/list/transferred_entry = gallery[1]
	TEST_ASSERT_EQUAL(transferred_entry["id"], entry["id"], "Transplanting the limb changed the identity of the same tattoo.")

/// A glove hides hand ink but leaves the uncovered upper arm available in the same session mask.
/datum/unit_test/drawn_tattoo_gloves/Run()
	var/mob/living/carbon/human/subject = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/bodypart/arm = subject.get_bodypart(BODY_ZONE_L_ARM)
	var/icon/bare = arm.tattoo_skin_icon(SOUTH)
	TEST_ASSERT(bare.GetPixel(22, 13) && bare.GetPixel(22, 18), "The human hand and upper arm did not share the selected limb mask.")
	var/datum/tattoo_design/design = allocate(/datum/tattoo_design)
	var/index = (64 - 26) * 64 + 43
	var/art = splicetext(repeat_string(4096, "0"), index, index + 1, "1")
	TEST_ASSERT(design.prepare(arm, SOUTH, art, list("#ff0000")), "An uncovered hand rejected a drawn dot.")
	var/obj/item/clothing/gloves/gloves = allocate(/obj/item/clothing/gloves/color/black)
	TEST_ASSERT(subject.equip_to_slot_if_possible(gloves, ITEM_SLOT_GLOVES), "The test subject could not put on gloves.")
	var/icon/gloved = arm.tattoo_skin_icon(SOUTH)
	TEST_ASSERT(gloved && gloved.GetPixel(22, 18), "A glove hid the upper arm.")
	TEST_ASSERT(!gloved.GetPixel(22, 13), "The editor could paint through a glove.")
	TEST_ASSERT(!arm.apply_drawn_tattoo(design), "A glove put on after review did not protect the hand.")
	subject.dropItemToGround(gloves, force = TRUE)
	TEST_ASSERT(arm.apply_drawn_tattoo(design), "Removing the glove did not expose the hand.")
	var/hand_ink_visible = FALSE
	for(var/image/overlay as anything in arm.get_limb_icon(dropped = FALSE))
		if(overlay.layer <= -arm.aux_layer || overlay.layer >= -GLOVES_LAYER)
			continue
		var/icon/overlay_icon = icon(overlay.icon, overlay.icon_state, SOUTH)
		if(lowertext(overlay_icon.GetPixel(22, 13)) == "#ff0000")
			hand_ink_visible = TRUE
	TEST_ASSERT(hand_ink_visible, "The wearer's hand sprite hid the tattoo on top of it.")
	subject.equip_to_slot_if_possible(gloves, ITEM_SLOT_GLOVES)
	var/list/details = subject.examine_more(subject)
	TEST_ASSERT(!findtext(jointext(details, ""), design.examine_image_url), "The detailed hand drawing was visible through a glove.")
	TEST_ASSERT(!length(subject.get_visible_drawn_tattoos(subject)), "The tab showed a drawing covered by a glove.")
