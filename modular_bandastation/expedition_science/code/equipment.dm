/** A sealed physical specimen; its discovery record is independent of this particular container. */
/obj/item/stationtrauma_sample
	name = "контейнер для экспедиционной пробы"
	desc = "Используйте пустой контейнер на обследованной находке. Запечатанную пробу нужно доставить к лабораторному анализатору."
	icon = 'icons/obj/science/vatgrowing.dmi'
	icon_state = "petri_dish"
	w_class = WEIGHT_CLASS_SMALL
	/// Discovery metadata shared with the source, never regenerated by the laboratory.
	var/datum/stationtrauma_research_record/record
	/// Each physical sample has its own ID and laboratory result.
	var/sample_id
	/// Collector captured when sampling actually completes.
	var/collected_by
	/// Completed laboratory observations belong to this physical sample.
	var/analyzed = FALSE
	/// Prevent overlapping collection with the same container.
	var/busy = FALSE

/obj/item/stationtrauma_sample/update_overlays()
	. = ..()
	if(record)
		var/mutable_appearance/sample_overlay = mutable_appearance(icon, "petri_dish_overlay")
		sample_overlay.color = "#83a7a0"
		. += sample_overlay
		. += mutable_appearance(icon, "petri_dish_overlay2")

/obj/item/stationtrauma_sample/examine(mob/user)
	. = ..()
	if(record)
		. += span_notice("Проба [sample_id], находка [record.id]. Отбор: [html_encode(collected_by)]. [analyzed ? "Лабораторный анализ выполнен." : "Требуется лабораторный анализ."]")

/obj/item/stationtrauma_sample/attack_self(mob/user)
	if(record)
		to_chat(user, span_notice(record.specimen_text(analyzed)))

/obj/item/stationtrauma_sample/pre_attack(atom/target, mob/living/user, list/modifiers, list/attack_modifiers)
	if(!istype(target, /obj/structure/stationtrauma_research_source))
		return ..()
	if(record || busy || !user.is_holding(src))
		return TRUE
	var/obj/structure/stationtrauma_research_source/source = target
	if(!source.record?.surveyed)
		to_chat(user, span_warning("Сначала обследуйте находку полевым сканером."))
	else if(source.remaining_samples <= 0)
		to_chat(user, span_warning("Пригодных для отбора проб больше нет."))
	else
		INVOKE_ASYNC(src, PROC_REF(collect), source, user)
	return TRUE

/** Commit one finite sample only after success; simultaneous collectors recheck the stock. */
/obj/item/stationtrauma_sample/proc/collect(obj/structure/stationtrauma_research_source/source, mob/living/user)
	if(busy || record || QDELETED(source) || !source.record?.surveyed || source.remaining_samples <= 0 || !user?.is_holding(src) || !user.can_perform_action(source, NEED_HANDS|FORBID_TELEKINESIS_REACH))
		return
	busy = TRUE
	var/datum/mind/operator = user.mind
	var/datum/stationtrauma_research_record/original_record = source.record
	to_chat(user, span_notice("Вы начинаете отбор пробы [source]."))
	var/completed = do_after(user, 6 SECONDS, source)
	if(QDELETED(src))
		return
	busy = FALSE
	if(!completed || QDELETED(source) || QDELETED(user) || record || source.record != original_record || !original_record?.surveyed || source.remaining_samples <= 0 || user.mind != operator || !user.is_holding(src) || !user.can_perform_action(source, NEED_HANDS|FORBID_TELEKINESIS_REACH))
		return
	source.remaining_samples--
	record = original_record
	GLOB.stationtrauma_research_serial++
	sample_id = "S-[GLOB.stationtrauma_research_serial]"
	collected_by = user.real_name
	record.log_observation(user, source, "Отобрана проба [sample_id]. Осталось проб: [source.remaining_samples].")
	name = "экспедиционная проба [sample_id]"
	update_appearance()
	balloon_alert(user, "проба запечатана")
	playsound(src, 'sound/machines/ping.ogg', 25, TRUE)

/** Laboratory analyzer requiring a held specimen throughout the analysis. */
/obj/machinery/stationtrauma_sample_analyzer
	name = "лабораторный анализатор образцов"
	desc = "Приложите запечатанную экспедиционную пробу для анализа и печати отчёта."
	icon = 'icons/obj/science/vatgrowing.dmi'
	icon_state = "microscope"
	density = TRUE
	use_power = IDLE_POWER_USE
	idle_power_usage = 100
	active_power_usage = 500
	circuit = /obj/item/circuitboard/machine/stationtrauma_sample_analyzer
	processing_flags = NONE
	/// A single operator can use this instrument at a time.
	var/busy = FALSE
	/// A temporary outage or breakdown invalidates the whole pending analysis.
	var/operation_interrupted = FALSE

/obj/machinery/stationtrauma_sample_analyzer/on_set_machine_stat(old_value)
	. = ..()
	if(busy && !is_operational)
		operation_interrupted = TRUE

/obj/machinery/stationtrauma_sample_analyzer/item_interaction(mob/living/user, obj/item/tool, list/modifiers)
	if(!istype(tool, /obj/item/stationtrauma_sample))
		return ..()
	var/obj/item/stationtrauma_sample/sample = tool
	if(busy || !is_operational || !sample.record || sample.analyzed || !user.is_holding(sample))
		balloon_alert(user, "проверьте прибор и пробу")
		return ITEM_INTERACT_BLOCKING
	INVOKE_ASYNC(src, PROC_REF(analyze), sample, user)
	return ITEM_INTERACT_SUCCESS

/** Interrupted or unpowered work never consumes or completes a sample. */
/obj/machinery/stationtrauma_sample_analyzer/proc/analyze(obj/item/stationtrauma_sample/sample, mob/living/user)
	if(busy || !is_operational || QDELETED(sample) || !sample.record || sample.analyzed || !user?.is_holding(sample) || !user.can_perform_action(src, NEED_HANDS|FORBID_TELEKINESIS_REACH))
		return
	busy = TRUE
	operation_interrupted = FALSE
	update_use_power(ACTIVE_POWER_USE)
	var/datum/mind/operator = user.mind
	var/datum/stationtrauma_research_record/original_record = sample.record
	to_chat(user, span_notice("Вы начинаете лабораторный анализ [sample]."))
	var/completed = do_after(user, 20 SECONDS, src)
	if(QDELETED(src))
		return
	busy = FALSE
	update_use_power(IDLE_POWER_USE)
	if(!completed || operation_interrupted || !is_operational || QDELETED(sample) || QDELETED(user) || sample.record != original_record || sample.analyzed || user.mind != operator || !user.is_holding(sample) || !user.can_perform_action(src, NEED_HANDS|FORBID_TELEKINESIS_REACH))
		return
	sample.analyzed = TRUE
	original_record.log_observation(user, src, "Лабораторный анализ пробы [sample.sample_id]: [original_record.laboratory_notes]")
	SEND_GLOBAL_SIGNAL(COMSIG_GLOB_EXPEDITION_SAMPLE_ANALYZED, original_record, user, src)
	var/obj/item/paper/report = new /obj/item/paper/stationtrauma_research_report(drop_location())
	report.name = "лабораторный отчёт [sample.sample_id]"
	report.add_raw_text("<b>Проба [html_encode(sample.sample_id)]</b><br>Отбор: [html_encode(sample.collected_by)]<br>Аналитик: [html_encode(user.real_name)]<br>[original_record.specimen_text(TRUE)]", advanced_html = TRUE)
	to_chat(user, span_notice("Анализ выполнен. Отчёт напечатан; результаты также доступны при использовании пробы в руке."))
	playsound(src, 'sound/machines/ping.ogg', 40, TRUE)

/** Laboratory records must not enter the unrelated message-in-a-bottle persistence queue. */
/obj/item/paper/stationtrauma_research_report
	can_become_message_in_bottle = FALSE

/** Construction board for the sample analyzer. */
/obj/item/circuitboard/machine/stationtrauma_sample_analyzer
	name = "Лабораторный анализатор образцов"
	build_path = /obj/machinery/stationtrauma_sample_analyzer
	req_components = list(/datum/stock_part/scanning_module = 1, /datum/stock_part/servo = 1)

/** Field scanner and sample-container kit. */
/obj/item/storage/box/stationtrauma_research
	name = "комплект полевого исследователя"
	desc = "Стратиграфический сканер и четыре стерильных контейнера для экспедиционных проб."

/obj/item/storage/box/stationtrauma_research/PopulateContents()
	new /obj/item/excavation/depth_scanner(src)
	for(var/index in 1 to 4)
		new /obj/item/stationtrauma_sample(src)
