/// The same synthetic body rejected by the sampler must not receive biological vault rewards.
/datum/unit_test/ipc_dna_vault_eligibility/Run()
	var/obj/machinery/dna_vault/vault = allocate(/obj/machinery/dna_vault)
	vault.completed = TRUE
	var/obj/item/dna_probe/probe = allocate(/obj/item/dna_probe)
	var/mob/living/carbon/human/ipc = allocate(/mob/living/carbon/human/consistent)
	ipc.set_species(/datum/species/ipc)
	TEST_ASSERT(probe.try_linking_vault(vault, ipc), "Could not link the DNA sampler for the IPC test.")
	TEST_ASSERT(!probe.scan_dna(ipc, ipc), "The sampler collected DNA from a synthetic IPC.")
	TEST_ASSERT_EQUAL(length(probe.stored_dna_human), 0, "The rejected IPC scan stored a DNA sample.")
	vault.roll_powers(ipc)
	TEST_ASSERT_EQUAL(length(vault.power_lottery), 0, "The DNA vault generated rewards for an IPC.")

	// Simulate rewards cached before a transformation or supplied by an obsolete UI.
	vault.power_lottery[WEAKREF(ipc)] = list(/datum/mutation/fire_immunity, /datum/mutation/quick_recovery)
	var/list/data = vault.ui_data(ipc)
	TEST_ASSERT(data["used"], "The vault displayed gene therapy for an incompatible IPC.")
	TEST_ASSERT_EQUAL(data["choiceA"], "", "The vault exposed a cached fire-immunity choice to an IPC.")
	TEST_ASSERT_EQUAL(data["choiceB"], "", "The vault exposed a cached recovery choice to an IPC.")
	var/original_stun_modifier = GET_PHYSIOLOGY(ipc, PHYS_COEFF_STUN)
	var/original_burn_modifier = GET_PHYSIOLOGY(ipc, BURN)
	vault.upgrade(ipc, "Fire Immunity")
	vault.upgrade(ipc, "Quick Recovery")
	TEST_ASSERT_NULL(ipc.dna.get_mutation(/datum/mutation/fire_immunity), "A stale vault choice gave an IPC fire immunity.")
	TEST_ASSERT_NULL(ipc.dna.get_mutation(/datum/mutation/quick_recovery), "A stale vault choice improved IPC recovery.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_NOFIRE), "A rejected vault reward left an IPC fireproof.")
	TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(ipc, PHYS_COEFF_STUN), original_stun_modifier, "The vault changed an IPC's stun recovery.")
	TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(ipc, BURN), original_burn_modifier, "The vault changed an IPC's burn resistance.")
	TEST_ASSERT(!HAS_TRAIT(ipc, TRAIT_USED_DNA_VAULT), "A rejected reward consumed the IPC's vault use.")

/// Human rewards still work, and turning their recipient into an IPC must undo their effects.
/datum/unit_test/ipc_dna_vault_species_change/Run()
	var/obj/machinery/dna_vault/vault = allocate(/obj/machinery/dna_vault)
	var/mob/living/carbon/human/ipc_control = allocate(/mob/living/carbon/human/consistent)
	ipc_control.set_species(/datum/species/ipc)
	for(var/datum/mutation/reward as anything in list(/datum/mutation/fire_immunity, /datum/mutation/quick_recovery))
		var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
		TEST_ASSERT(human.can_mutate(), "The organic control could not receive genetic therapy.")
		vault.roll_powers(human)
		TEST_ASSERT_EQUAL(length(vault.power_lottery[WEAKREF(human)]), 2, "The vault stopped generating two rewards for normal humans.")
		vault.power_lottery[WEAKREF(human)] = list(/datum/mutation/fire_immunity, /datum/mutation/quick_recovery)
		vault.completed = FALSE
		vault.upgrade(human, initial(reward.name))
		TEST_ASSERT_NULL(human.dna.get_mutation(reward), "An incomplete vault granted a reward.")
		TEST_ASSERT(!HAS_TRAIT(human, TRAIT_USED_DNA_VAULT), "An incomplete vault consumed a human's reward.")
		vault.completed = TRUE
		var/list/data = vault.ui_data(human)
		TEST_ASSERT(!data["used"], "The completed vault hid a normal human's reward choices.")
		vault.upgrade(human, initial(reward.name))
		TEST_ASSERT_NOTNULL(human.dna.get_mutation(reward), "The completed vault did not grant [reward] to a human.")
		TEST_ASSERT(HAS_TRAIT(human, TRAIT_USED_DNA_VAULT), "A successful reward did not consume the human's vault use.")
		if(reward == /datum/mutation/fire_immunity)
			TEST_ASSERT(HAS_TRAIT(human, TRAIT_NOFIRE), "Human vault fire immunity had no effect.")
			TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(human, BURN), 0.5, "Human vault fire immunity did not reduce burn damage.")
		else
			TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(human, PHYS_COEFF_STUN), 0.5, "Human vault recovery had no effect.")

		human.set_species(/datum/species/ipc)
		TEST_ASSERT_NULL(human.dna.get_mutation(reward), "Vault mutation [reward] survived conversion into an IPC.")
		TEST_ASSERT(!HAS_TRAIT(human, TRAIT_NOFIRE), "Human vault fire immunity survived conversion into an IPC.")
		TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(human, PHYS_COEFF_STUN), GET_PHYSIOLOGY(ipc_control, PHYS_COEFF_STUN), "A transformed IPC retained the human vault recovery bonus.")
		TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(human, BURN), GET_PHYSIOLOGY(ipc_control, BURN), "A transformed IPC retained human vault burn resistance.")
		TEST_ASSERT(HAS_TRAIT(human, TRAIT_USED_DNA_VAULT), "A species change reset the already-consumed vault reward.")

		vault.power_lottery[WEAKREF(human)] = list(/datum/mutation/fire_immunity, /datum/mutation/quick_recovery)
		vault.upgrade(human, initial(reward.name))
		TEST_ASSERT_NULL(human.dna.get_mutation(reward), "The transformed IPC redeemed a cached human reward.")

/// The shared genetics trait must govern rewards for every geneless body, rather than just IPCs.
/datum/unit_test/ipc_dna_vault_geneless_control/Run()
	var/obj/machinery/dna_vault/vault = allocate(/obj/machinery/dna_vault)
	vault.completed = TRUE
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human/consistent)
	human.dna.add_mutation(/datum/mutation/fire_immunity, MUTATION_SOURCE_DNA_VAULT)
	TEST_ASSERT(HAS_TRAIT(human, TRAIT_NOFIRE), "The organic geneless control did not receive its initial mutation.")
	ADD_TRAIT(human, TRAIT_GENELESS, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT_NULL(human.dna.get_mutation(/datum/mutation/fire_immunity), "Gaining the geneless trait retained a vault mutation.")
	TEST_ASSERT(!HAS_TRAIT(human, TRAIT_NOFIRE), "Gaining the geneless trait retained vault fire immunity.")
	TEST_ASSERT_EQUAL(GET_PHYSIOLOGY(human, BURN), 1, "Removing vault therapy did not restore organic burn resistance.")
	vault.roll_powers(human)
	TEST_ASSERT_EQUAL(length(vault.power_lottery), 0, "The vault rolled rewards for a non-IPC geneless human.")
	vault.power_lottery[WEAKREF(human)] = list(/datum/mutation/fire_immunity, /datum/mutation/quick_recovery)
	vault.upgrade(human, "Fire Immunity")
	TEST_ASSERT_NULL(human.dna.get_mutation(/datum/mutation/fire_immunity), "A geneless human redeemed a cached reward.")
	REMOVE_TRAIT(human, TRAIT_GENELESS, TRAIT_SOURCE_UNIT_TESTS)
	vault.upgrade(human, "Fire Immunity")
	TEST_ASSERT_NOTNULL(human.dna.get_mutation(/datum/mutation/fire_immunity), "Restoring human genetics did not restore vault eligibility.")
