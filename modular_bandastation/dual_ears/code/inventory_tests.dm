// AI EDIT START - Implement and verify independent ear slots
/datum/unit_test/dual_ears_inventory/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_appropriate_slot(right), "Could not equip the first headset.")
	TEST_ASSERT(wearer.equip_to_appropriate_slot(left), "Could not equip the second headset.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_RIGHT), right, "Automatic equipment should prefer the right ear.")
	TEST_ASSERT_EQUAL(wearer.get_item_by_slot(ITEM_SLOT_EAR_LEFT), left, "Automatic equipment should fall back to the left ear.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(right), ITEM_SLOT_EAR_RIGHT, "The right headset returned the wrong slot.")
	TEST_ASSERT_EQUAL(wearer.get_slot_by_item(left), ITEM_SLOT_EAR_LEFT, "The left headset returned the wrong slot.")
	var/list/equipped = wearer.get_equipped_items()
	TEST_ASSERT((right in equipped) && (left in equipped), "Equipped-item enumeration omitted an ear.")
	var/list/selected = wearer.get_items_by_slots(ITEM_SLOT_EARS)
	TEST_ASSERT((right in selected) && (left in selected), "The ears mask did not select both headsets.")

/datum/unit_test/dual_ears_lifecycle/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the right headset.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the left headset.")
	TEST_ASSERT(wearer.dropItemToGround(right), "Could not drop the right headset.")
	TEST_ASSERT_NULL(wearer.ear_right, "Dropping the right headset left its slot occupied.")
	TEST_ASSERT_EQUAL(wearer.ear_left, left, "Dropping the right headset cleared the left slot.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not re-equip the right headset.")
	left.forceMove(wearer.drop_location())
	TEST_ASSERT_NULL(wearer.ear_left, "Moving the left headset left a stale slot reference.")
	TEST_ASSERT_EQUAL(wearer.ear_right, right, "Moving the left headset cleared the right slot.")
	qdel(right)
	TEST_ASSERT_NULL(wearer.ear_right, "Deleting the right headset left a stale slot reference.")

/datum/unit_test/dual_ears_decapitation/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/radio/headset/right = allocate(/obj/item/radio/headset)
	var/obj/item/radio/headset/left = allocate(/obj/item/radio/headset)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT), "Could not equip the right headset.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT), "Could not equip the left headset.")
	var/obj/item/bodypart/head/head = wearer.get_bodypart(BODY_ZONE_HEAD)
	allocated += head
	head.drop_limb()
	TEST_ASSERT_NULL(wearer.ear_right, "Decapitation retained the right headset.")
	TEST_ASSERT_NULL(wearer.ear_left, "Decapitation retained the left headset.")
	TEST_ASSERT_EQUAL(right.loc, wearer.drop_location(), "Decapitation did not drop the right headset.")
	TEST_ASSERT_EQUAL(left.loc, wearer.drop_location(), "Decapitation did not drop the left headset.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(right, ITEM_SLOT_EAR_RIGHT, disable_warning = TRUE), "A headless mob could equip its right ear.")
	TEST_ASSERT(!wearer.equip_to_slot_if_possible(left, ITEM_SLOT_EAR_LEFT, disable_warning = TRUE), "A headless mob could equip its left ear.")

/datum/unit_test/dual_ears_fire_coverage/Run()
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	var/obj/item/clothing/ears/earmuffs/muffs = allocate(/obj/item/clothing/ears/earmuffs)
	var/obj/item/clothing/head/helmet/toggleable/riot/helmet = allocate(/obj/item/clothing/head/helmet/toggleable/riot)
	TEST_ASSERT(wearer.equip_to_slot_if_possible(muffs, ITEM_SLOT_EAR_LEFT), "Could not equip the earmuffs.")
	TEST_ASSERT(wearer.equip_to_slot_if_possible(helmet, ITEM_SLOT_HEAD), "Could not equip the helmet.")
	wearer.burn_clothing(1, 4)
	TEST_ASSERT(!(muffs.resistance_flags & ON_FIRE), "Covered earmuffs caught fire.")
	TEST_ASSERT(wearer.dropItemToGround(helmet), "Could not remove the helmet.")
	wearer.burn_clothing(1, 4)
	TEST_ASSERT(muffs.resistance_flags & ON_FIRE, "Exposed earmuffs were omitted from fire damage.")

/datum/unit_test/dual_ears_outfit/Run()
	var/datum/outfit/outfit = allocate(/datum/outfit)
	outfit.ear_right = /obj/item/radio/headset/headset_med
	outfit.ear_left = /obj/item/radio/headset/headset_eng
	var/list/saved = json_decode(json_encode(outfit.get_json_data()))
	var/datum/outfit/restored = allocate(/datum/outfit)
	TEST_ASSERT(restored.load_from(saved), "Could not load a two-ear outfit.")
	TEST_ASSERT_EQUAL(restored.ear_right, outfit.ear_right, "The outfit round trip changed the right ear.")
	TEST_ASSERT_EQUAL(restored.ear_left, outfit.ear_left, "The outfit round trip changed the left ear.")
	var/mob/living/carbon/human/wearer = allocate(/mob/living/carbon/human/consistent)
	TEST_ASSERT(restored.equip(wearer), "Could not equip the restored outfit.")
	TEST_ASSERT(istype(wearer.ear_right, /obj/item/radio/headset/headset_med), "The restored right-ear item was not equipped.")
	TEST_ASSERT(istype(wearer.ear_left, /obj/item/radio/headset/headset_eng), "The restored left-ear item was not equipped.")

/datum/unit_test/dual_ears_legacy_outfit/Run()
	var/datum/outfit/outfit = allocate(/datum/outfit)
	TEST_ASSERT(outfit.load_from(list("ears" = "/obj/item/radio/headset")), "Could not load a legacy outfit.")
	TEST_ASSERT_EQUAL(outfit.ear_right, /obj/item/radio/headset, "The legacy ears key was not loaded into the right ear.")
	TEST_ASSERT_NULL(outfit.ear_left, "A legacy outfit populated the left ear.")
	TEST_ASSERT(outfit.load_from(list("ear_right" = null, "ears" = "/obj/item/radio/headset")), "Could not load an explicitly empty right ear.")
	TEST_ASSERT_NULL(outfit.ear_right, "The legacy key overrode an explicitly empty right ear.")
// AI EDIT END
