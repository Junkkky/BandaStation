/// Exercises physical illustration sources, scanner snapshots, archive restoration and independent printed copies.
/datum/unit_test/illustrated_book_edition/Run()
	var/obj/item/book/book = allocate(/obj/item/book)
	var/mob/living/carbon/human/consistent/author = allocate(/mob/living/carbon/human/consistent)
	var/datum/tgui/editor = allocate(/datum/tgui, author, book, "IllustratedBook")
	var/obj/item/pen/pen = allocate(/obj/item/pen)
	author.put_in_hands(pen)
	book.ui_act("save_page", list("page" = 1, "text" = "Лист <один>", "revision" = 0), editor)
	TEST_ASSERT_EQUAL(book.book_data.get_content(), "Лист <один>", "The pen must update the selected page.")
	book.ui_act("insert_page", list("page" = 1, "revision" = 0), editor)
	TEST_ASSERT_EQUAL(length(book.book_data.get_pages()), 1, "A stale editor inserted a page.")
	book.ui_act("insert_page", list("page" = 1, "revision" = book.book_data.revision), editor)
	TEST_ASSERT_EQUAL(length(book.book_data.get_pages()), 2, "The author could not insert a second page.")
	var/binding_revision = book.book_data.revision
	book.ui_act("save_cover", list("bindingColor" = "blue", "revision" = binding_revision), editor)
	TEST_ASSERT_EQUAL(book.book_data.binding_color, "blue", "The author could not choose a blue binding.")
	TEST_ASSERT_EQUAL(book.icon_state, "book4", "The manuscript did not receive the blue book sprite.")
	book.ui_act("save_cover", list("bindingColor" = "red", "revision" = binding_revision), editor)
	book.ui_act("save_cover", list("bindingColor" = "unknown", "revision" = book.book_data.revision), editor)
	TEST_ASSERT_EQUAL(book.book_data.revision, binding_revision + 1, "A stale or unknown color changed the edition.")

	var/obj/item/photo/photo = allocate(/obj/item/photo)
	photo.picture = new(image = icon('icons/obj/service/library.dmi', "book"))
	author.put_in_hands(photo)
	book.ui_act("attach_image", list("page" = 1, "revision" = book.book_data.revision), editor)
	book.ui_act("attach_cover", list("revision" = book.book_data.revision), editor)
	var/photo_cover = book.book_data.cover_image
	TEST_ASSERT(photo_cover, "The photograph did not appear on the cover.")
	author.dropItemToGround(photo)
	var/obj/item/canvas/canvas = allocate(/obj/item/canvas)
	author.put_in_hands(canvas)
	var/prior_revision = book.book_data.revision
	book.ui_act("attach_image", list("page" = 2, "revision" = prior_revision), editor)
	book.ui_act("attach_cover", list("revision" = prior_revision), editor)
	TEST_ASSERT_EQUAL(book.book_data.revision, prior_revision, "An unfinished canvas was attached.")
	canvas.generate_proper_overlay()
	canvas.finalized = TRUE
	book.ui_act("attach_image", list("page" = 2, "revision" = prior_revision), editor)
	book.ui_act("attach_cover", list("revision" = prior_revision), editor)
	TEST_ASSERT_EQUAL(book.book_data.cover_image, photo_cover, "A stale action replaced the cover.")
	book.ui_act("attach_cover", list("revision" = book.book_data.revision), editor)
	book.ui_act("save_page", list("page" = 2, "text" = "", "caption" = "Зарисовка", "revision" = book.book_data.revision), editor)
	var/list/pages = book.book_data.get_pages()
	TEST_ASSERT(pages[1]["image"] && pages[2]["image"], "Both photograph and canvas must be embedded.")
	TEST_ASSERT_NOTEQUAL(pages[1]["image"], pages[2]["image"], "The two physical sources were confused.")
	TEST_ASSERT_EQUAL(pages[1]["image"], photo_cover, "Replacing the cover altered the photograph on page one.")
	TEST_ASSERT_EQUAL(pages[2]["image"], book.book_data.cover_image, "The finished canvas did not replace the cover.")
	author.dropItemToGround(pen)
	book.ui_act("save_cover", list("bindingColor" = "red", "revision" = book.book_data.revision), editor)
	TEST_ASSERT_EQUAL(book.book_data.binding_color, "blue", "A reader without a pen recolored the binding.")
	book.ui_act("delete_page", list("page" = 1, "revision" = book.book_data.revision), editor)
	TEST_ASSERT_EQUAL(length(book.book_data.get_pages()), 2, "An editor without a pen deleted a page.")

	var/obj/machinery/libraryscanner/scanner = allocate(/obj/machinery/libraryscanner)
	author.put_in_hands(book)
	scanner.item_interaction(author, book)
	var/datum/tgui/scan_ui = allocate(/datum/tgui, author, scanner, "LibraryScanner")
	scanner.ui_act("scan", list(), scan_ui)
	TEST_ASSERT_NOTNULL(scanner.cache, "No edition captured by the scanner.")
	var/datum/book_info/restored = new(scanner.cache.title, scanner.cache.author, scanner.cache.content)
	TEST_ASSERT(restored.load_pages(scanner.cache.serialize_pages()), "The archived edition could not be decoded.")
	TEST_ASSERT(restored.compare(book.book_data), "The archive changed page order, text, caption or image bytes.")
	var/obj/machinery/computer/libraryconsole/bookmanagement/printer = allocate(/obj/machinery/computer/libraryconsole/bookmanagement)
	printer.print_edition(restored, 2)
	var/list/printed = list()
	for(var/obj/item/book/copy in get_turf(printer))
		printed += copy
	TEST_ASSERT_EQUAL(length(printed), 2, "The print run should produce exactly two physical copies.")
	var/obj/item/book/first = printed[1]
	var/obj/item/book/second = printed[2]
	TEST_ASSERT(first.book_data.compare(restored) && second.book_data.compare(restored), "The printer lost part of the edition.")
	TEST_ASSERT_EQUAL(first.book_data.cover_image, book.book_data.cover_image, "A printed copy lost its cover.")
	for(var/obj/item/book/copy as anything in printed)
		var/list/cover_view = copy.ui_static_data(author)
		TEST_ASSERT_EQUAL(cover_view["bindingColor"], "blue", "A printed copy displayed the wrong binding color.")
		TEST_ASSERT_EQUAL(copy.icon_state, "book4", "A printed copy lost the blue book sprite.")
	author.put_in_hands(pen)
	var/datum/tgui/copy_editor = allocate(/datum/tgui, author, first, "IllustratedBook")
	first.ui_act("save_cover", list("bindingColor" = "red", "revision" = first.book_data.revision), copy_editor)
	TEST_ASSERT_EQUAL(first.book_data.binding_color, "red", "Recoloring a printed copy failed.")
	TEST_ASSERT(!first.book_data.compare(restored) && second.book_data.compare(scanner.cache), "Changing only the color altered the archive or its sibling, or went undetected.")
	first.ui_act("save_cover", list("bindingColor" = "blue", "revision" = first.book_data.revision), copy_editor)
	TEST_ASSERT(first.book_data.compare(restored), "Restoring the color did not restore the matching edition.")
	TEST_ASSERT(first.book_data.set_page_image(1, null), "The first copy could not be edited.")
	TEST_ASSERT(!first.book_data.compare(restored) && second.book_data.compare(scanner.cache), "Editing one copy changed its sibling or the scan.")
	TEST_ASSERT(second.book_data.set_cover_image(null), "Could not remove art from the second copy.")
	TEST_ASSERT(!second.book_data.compare(scanner.cache), "Changing only the cover went undetected.")
	TEST_ASSERT(first.book_data.cover_image == restored.cover_image && restored.compare(scanner.cache), "Changing one cover altered another copy or the scan.")

/// Old archive rows must be pageable without rewriting or losing their Cyrillic content.
/datum/unit_test/illustrated_book_legacy/Run()
	var/original = repeat_string(220, "Дневник & журнал. ")
	var/datum/book_info/book = new("Книга", "Автор", html_encode(original))
	TEST_ASSERT(book.load_pages(null), "An archive entry without pages should still open.")
	var/list/texts = list()
	for(var/list/page as anything in book.get_pages())
		texts += page["text"]
	TEST_ASSERT(length(texts) > 1, "The legacy book was not paginated.")
	TEST_ASSERT_EQUAL(jointext(texts, ""), original, "Legacy pagination dropped or split a character.")
	TEST_ASSERT_NULL(book.serialize_pages(), "Merely reading a legacy book rewrote its archive format.")
	TEST_ASSERT(!book.load_pages("{broken"), "An invalid archive entry was accepted.")
	TEST_ASSERT_EQUAL(book.get_content(), original, "A damaged archive entry destroyed the readable fallback.")
	var/datum/book_info/covered = allocate(/datum/book_info)
	var/png = icon2base64(icon('icons/obj/service/library.dmi', "book"))
	TEST_ASSERT(book.set_cover_image(png), "The legacy text edition rejected a cover.")
	var/datum/book_info/old_copy = new(book.title, book.author, book.content)
	TEST_ASSERT(old_copy.load_pages(book.serialize_pages()), "The legacy text with a cover could not be restored.")
	TEST_ASSERT(old_copy.cover_image == png && old_copy.get_content() == original, "Adding a cover changed the original legacy text.")
	TEST_ASSERT(old_copy.set_cover_image(null), "Could not remove the old edition's cover.")
	TEST_ASSERT_NULL(old_copy.serialize_pages(), "A legacy text edition kept a cover or gained pages after removing the image.")
	TEST_ASSERT(covered.set_cover_image(png) && covered.has_content(), "A cover-only edition could not be archived.")
	TEST_ASSERT(!covered.load_pages(json_encode(list("version" = 1, "cover" = "invalid", "pages" = list()))), "A damaged archived cover was accepted.")
	TEST_ASSERT_EQUAL(covered.cover_image, png, "A bad archive overwrote the previous cover.")
	TEST_ASSERT(covered.load_pages(json_encode(list(list("text" = "Старая страница", "image" = null, "caption" = "")))), "A pre-cover illustrated edition was rejected.")
	TEST_ASSERT_NULL(covered.cover_image, "A pre-cover edition inherited the previous cover.")
	TEST_ASSERT_EQUAL(covered.get_content(), "Старая страница", "Legacy array pages were changed.")
	var/color_only = json_encode(list("version" = 1, "bindingColor" = "purple", "cover" = null, "pages" = null))
	TEST_ASSERT(old_copy.load_pages(color_only), "A colored legacy binding required a cover illustration.")
	TEST_ASSERT_EQUAL(old_copy.get_content(), original, "Loading the binding changed the original text.")
	TEST_ASSERT(!old_copy.load_pages(json_encode(list("version" = 1, "bindingColor" = "unknown", "cover" = null, "pages" = null))), "An unknown archived color was accepted.")
	TEST_ASSERT_EQUAL(old_copy.binding_color, "purple", "An invalid archive overwrote the current binding color.")
	TEST_ASSERT(old_copy.load_pages(book.serialize_pages()), "A cover archive from before colors could not be loaded.")
	TEST_ASSERT_NULL(old_copy.binding_color, "An old edition inherited a previous binding color.")

/// Replace the external host with a deterministic image so this test also runs offline in CI.
/obj/item/book/link_preview_test
	var/imports = 0

/obj/item/book/link_preview_test/import_illustration(url, mob/living/user)
	imports++
	return list("image" = illustration_png(icon('icons/obj/service/library.dmi', "book")))

/// Preview belongs to its author and page. A confirmed edit embeds exactly those bytes in the edition.
/datum/unit_test/illustrated_book_link_preview/Run()
	var/obj/item/book/link_preview_test/book = allocate(/obj/item/book/link_preview_test)
	var/mob/living/carbon/human/consistent/author = allocate(/mob/living/carbon/human/consistent)
	var/mob/living/carbon/human/consistent/other = allocate(/mob/living/carbon/human/consistent)
	var/datum/tgui/editor = allocate(/datum/tgui, author, book, "IllustratedBook")
	var/datum/tgui/other_editor = allocate(/datum/tgui, other, book, "IllustratedBook")
	var/obj/item/pen/pen = allocate(/obj/item/pen)
	other.put_in_hands(allocate(/obj/item/pen))
	book.book_data.add_page(1)
	var/revision = book.book_data.revision
	var/list/preview = list("page" = 2, "revision" = revision, "url" = "https://file.garden/fixture/portrait.jpg", "requestId" = "testpreview1")
	book.ui_act("preview_illustration", preview, editor)
	TEST_ASSERT_EQUAL(book.imports, 0, "A reader without a pen started an import.")
	author.put_in_hands(pen)
	book.ui_act("preview_illustration", preview, editor)
	TEST_ASSERT_EQUAL(book.imports, 1, "Preview should read the source once.")
	var/list/author_view = book.ui_static_data(author)
	var/list/snapshot = author_view["illustrationPreview"]
	TEST_ASSERT_NOTNULL(snapshot, "The author did not receive the image preview.")
	var/png = snapshot["image"]
	TEST_ASSERT(png, "Preview did not contain a PNG snapshot.")
	var/list/pages = book.book_data.get_pages()
	TEST_ASSERT_NULL(pages[2]["image"], "Opening a preview changed the book before save.")
	var/list/other_view = book.ui_static_data(other)
	TEST_ASSERT_NULL(other_view["illustrationPreview"], "A second reader received the author's private preview.")
	var/list/save = list("page" = 2, "revision" = revision, "text" = "Лист из архива", "caption" = "Портрет", "illustrationRequestId" = "testpreview1")
	book.ui_act("save_cover", save, editor)
	TEST_ASSERT_NULL(book.book_data.cover_image, "A page preview was used as a cover.")
	book.ui_act("save_page", save, other_editor)
	TEST_ASSERT_EQUAL(book.book_data.revision, revision, "Another reader committed the preview.")
	save["page"] = 1
	book.ui_act("save_page", save, editor)
	TEST_ASSERT_EQUAL(book.book_data.revision, revision, "A preview was committed to a different page.")
	save["page"] = 2
	book.ui_act("save_page", save, editor)
	TEST_ASSERT_EQUAL(book.imports, 1, "Saving fetched the external image again.")
	pages = book.book_data.get_pages()
	TEST_ASSERT_EQUAL(pages[2]["image"], png, "The saved image differs from the approved preview.")
	TEST_ASSERT_EQUAL(pages[2]["text"], save["text"], "Text was lost when committing the image.")
	TEST_ASSERT_EQUAL(pages[2]["caption"], save["caption"], "Caption was lost when committing the image.")
	var/datum/book_info/archived = allocate(/datum/book_info)
	TEST_ASSERT(archived.load_pages(book.book_data.serialize_pages()), "The archive rejected the embedded image.")
	pages = archived.get_pages()
	TEST_ASSERT_EQUAL(pages[2]["image"], png, "The archive did not retain the snapshot.")

	revision = book.book_data.revision
	preview = list("page" = "cover", "revision" = revision, "url" = "https://file.garden/fixture/portrait.jpg", "requestId" = "coverpreview")
	book.ui_act("preview_illustration", preview, editor)
	TEST_ASSERT_NULL(book.book_data.cover_image, "A cover preview was published before confirmation.")
	save = list("revision" = revision, "illustrationRequestId" = "coverpreview", "bindingColor" = "green")
	book.ui_act("save_cover", save, other_editor)
	var/list/page_save = save.Copy()
	page_save["page"] = 1
	page_save["text"] = "Wrong destination"
	book.ui_act("save_page", page_save, editor)
	TEST_ASSERT_EQUAL(book.book_data.revision, revision, "A cover token was accepted by another reader or page.")
	book.ui_act("save_cover", save, editor)
	TEST_ASSERT_EQUAL(book.book_data.cover_image, png, "Confirmation lost the cover snapshot.")
	TEST_ASSERT_EQUAL(book.book_data.binding_color, "green", "Saving the art and color together lost the binding color.")
	TEST_ASSERT_EQUAL(book.imports, 2, "Saving the cover downloaded its image again.")
	book.ui_act("remove_cover", list("revision" = book.book_data.revision), editor)
	TEST_ASSERT_NULL(book.book_data.cover_image, "Removing the cover failed.")
	TEST_ASSERT_EQUAL(book.book_data.binding_color, "green", "Removing the artwork also removed the binding color.")
	pages = book.book_data.get_pages()
	TEST_ASSERT_EQUAL(pages[2]["image"], png, "Removing the cover damaged an illustrated page.")

/// Observes a book read through ordinary hearing and the TTS220 signal for an actual nearby listener.
/datum/unit_test/illustrated_book_read_aloud
	var/mob/living/carbon/human/reader
	var/mob/living/carbon/human/audience
	var/mob/living/carbon/human/far_listener
	var/list/heard = list()
	var/list/voiced = list()
	var/distant_voices = 0
	var/caption_message

/datum/unit_test/illustrated_book_read_aloud/proc/on_hear(datum/source, list/hearing_args)
	SIGNAL_HANDLER
	if(hearing_args[HEARING_SPEAKER] == reader && !hearing_args[HEARING_RADIO_FREQ])
		heard += hearing_args[HEARING_RAW_MESSAGE]

/datum/unit_test/illustrated_book_read_aloud/proc/on_voice(datum/source, mob/listener, message, atom/location, is_local, is_radio)
	SIGNAL_HANDLER
	if(listener == audience && is_local && !is_radio)
		voiced += message
	else if(listener == far_listener)
		distant_voices++

/datum/unit_test/illustrated_book_read_aloud/proc/on_caption(datum/source, list/speech_args)
	SIGNAL_HANDLER
	caption_message = speech_args[SPEECH_MESSAGE]

/datum/unit_test/illustrated_book_read_aloud/Run()
	var/obj/item/book/book = allocate(/obj/item/book)
	reader = allocate(/mob/living/carbon/human/consistent, run_loc_floor_bottom_left)
	audience = allocate(/mob/living/carbon/human/consistent/tts_listener, get_step(reader, EAST))
	audience.mock_client = allocate(/datum/client_interface)
	reader.voice = null
	far_listener = allocate(/mob/living/carbon/human/consistent/tts_listener, locate(reader.x + 10, reader.y, reader.z))
	far_listener.mock_client = allocate(/datum/client_interface)
	RegisterSignal(audience, COMSIG_MOVABLE_HEAR, PROC_REF(on_hear))
	// COMSIG_ATOM_TTS_CAST is defined by the modular TTS220 includes after the core unit tests.
	RegisterSignal(reader, "atom_tts_cast", PROC_REF(on_voice))
	var/datum/tgui/reader_ui = allocate(/datum/tgui, reader, book, "IllustratedBook")
	var/datum/tgui/audience_ui = allocate(/datum/tgui, audience, book, "IllustratedBook")
	book.book_data.add_page(1)
	book.book_data.set_page_text(2, ";**Обсерватория** ,o Слово. [repeat_string(35, "Отметка в журнале. ")]")
	var/list/request = list("page" = 2, "revision" = book.book_data.revision, "text" = "Forged speech")
	book.ui_act("read_aloud", request, reader_ui)
	TEST_ASSERT_EQUAL(length(heard), 0, "The book allowed someone to read from the floor.")
	reader.put_in_hands(book)
	var/list/stale = request.Copy()
	stale["revision"]--
	book.ui_act("read_aloud", stale, reader_ui)
	book.ui_act("read_aloud", list("page" = 2.5, "revision" = book.book_data.revision), reader_ui)
	book.ui_act("read_aloud", list("page" = 1, "revision" = book.book_data.revision), reader_ui)
	ADD_TRAIT(reader, TRAIT_MUTE, TRAIT_SOURCE_UNIT_TESTS)
	book.ui_act("read_aloud", request, reader_ui)
	REMOVE_TRAIT(reader, TRAIT_MUTE, TRAIT_SOURCE_UNIT_TESTS)
	TEST_ASSERT_EQUAL(length(heard), 0, "An invalid page, a stale request, or a mute reader produced speech.")
	book.ui_act("read_aloud", request, reader_ui)
	TEST_ASSERT_EQUAL(length(heard), 1, "The holder's first phrase did not reach the nearby listener exactly once as local speech.")
	TEST_ASSERT(findtext(heard[1], "Обсерватория ,o Слово") && !findtext(heard[1], "**") && !findtext(heard[1], "Forged speech"), "Reading must preserve the saved words and literal language prefixes without emphasis markup or client-supplied text.")
	TEST_ASSERT_EQUAL(length(voiced), 1, "The listener did not receive exactly one local TTS220 request from the reader.")
	TEST_ASSERT_EQUAL(voiced[1], heard[1], "TTS220 received different words from the listener.")
	TEST_ASSERT_EQUAL(distant_voices, 0, "A listener outside normal speech range received narration.")
	book.ui_act("read_aloud", request, reader_ui)
	book.ui_act("stop_reading", list(), audience_ui)
	TEST_ASSERT_EQUAL(length(heard), 1, "A repeated request duplicated the opening phrase.")
	var/list/view = book.ui_data(reader)
	TEST_ASSERT_EQUAL(view["readingPage"], 2, "A bystander interrupted the holder's reading.")
	reader.dropItemToGround(book)
	view = book.ui_data(reader)
	TEST_ASSERT(!view["readingPage"], "Putting down the book left the reader's session active.")
	audience.put_in_hands(book)
	view = book.ui_data(audience)
	TEST_ASSERT(view["canReadAloud"] && !view["readingPage"], "The new holder inherited the previous reader's narration.")
	book.book_data.set_page_image(1, icon2base64(icon('icons/obj/service/library.dmi', "book")))
	book.book_data.set_page_text(1, "", "Снимок маяка")
	RegisterSignal(audience, COMSIG_MOB_SAY, PROC_REF(on_caption))
	book.ui_act("read_aloud", list("page" = 1, "revision" = book.book_data.revision), audience_ui)
	view = book.ui_data(audience)
	TEST_ASSERT_EQUAL(view["readingPage"], 1, "The new holder could not read an illustration's caption.")
	TEST_ASSERT(findtext(caption_message, "Снимок маяка"), "The reader omitted the signed illustration's caption.")
	book.ui_act("stop_reading", list(), audience_ui)
	view = book.ui_data(audience)
	TEST_ASSERT(!view["readingPage"], "The holder's stop button did not end narration.")
