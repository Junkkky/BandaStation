/// Tests that no runtimes are thrown when a mob is on fire
/datum/unit_test/burning

/datum/unit_test/burning/Run()
	var/mob/living/carbon/human/dummy = allocate(/mob/living/carbon/human/consistent)
	var/initial_temp = dummy.bodytemperature
	// Light this baby up
	dummy.set_fire_stacks(20)
	dummy.ignite_mob()
	TEST_ASSERT(dummy.on_fire, "Dummy is not on fire despite having 20 fire stacks and being ignited.")
	// Manually tick it a few times
	var/datum/status_effect/fire_handler/fire_stacks/handler = locate() in dummy.status_effects
	handler.tick_interval = STATUS_EFFECT_AUTO_TICK
	for(var/i in 1 to 5)
		handler.process(1)
	TEST_ASSERT(dummy.fire_stacks < 20, "Dummy should have decayed firestacks, but did not. (Dummy stacks: [dummy.fire_stacks]).")
	TEST_ASSERT(dummy.bodytemperature > initial_temp, "Dummy did not heat up despite being on fire. (Dummy temp: [dummy.bodytemperature], initial temp: [initial_temp])")

/datum/unit_test/corpse_cremation
	var/turf/open/lava/lava
	var/original_floor_type

/datum/unit_test/corpse_cremation/Destroy()
	if(lava)
		lava.ChangeTurf(original_floor_type)
	return ..()

/datum/unit_test/corpse_cremation/proc/body_icon_states(mob/living/carbon/body)
	var/list/states = list()
	for(var/image/limb as anything in body.overlays_standing[BODYPARTS_LAYER])
		states[limb.icon_state] = TRUE
	return states

/datum/unit_test/corpse_cremation/proc/wait_for_dust(mob/living/body)
	var/deadline = world.time + 5 SECONDS
	while(!QDELETED(body) && world.time < deadline)
		stoplag()

/// Keep feeding the active fire as a burning tile would, without waiting twelve real minutes.
/datum/unit_test/corpse_cremation/proc/burn_for(mob/living/carbon/human/body, seconds)
	var/datum/status_effect/fire_handler/fire_stacks/fire = body.has_status_effect(/datum/status_effect/fire_handler/fire_stacks)
	while(seconds > 0)
		var/step_seconds = min(60, seconds)
		body.set_fire_stacks(20)
		fire.tick(step_seconds)
		seconds -= step_seconds

/datum/unit_test/corpse_cremation/Run()
	var/turf/fire_tile = run_loc_floor_bottom_left
	var/mob/living/carbon/human/body = allocate(/mob/living/carbon/human/consistent, fire_tile)
	var/mob/living/carbon/human/lava_body = allocate(/mob/living/carbon/human/consistent, run_loc_floor_top_right)
	TEST_ASSERT_NOTEQUAL(body, lava_body, "The fire and lava exposures must use different bodies.")
	body.set_fire_stacks(20)
	body.ignite_mob()
	burn_for(body, 120)
	TEST_ASSERT_EQUAL(body.cremation_stage, NONE, "A living human advanced through cremation.")

	body.death()
	var/obj/item/clothing/suit/suit = allocate(/obj/item/clothing/suit/utility/fire/atmos)
	var/obj/item/clothing/head/helmet = allocate(/obj/item/clothing/head/utility/hardhat/welding/atmos)
	TEST_ASSERT(body.equip_to_slot_if_possible(suit, ITEM_SLOT_OCLOTHING), "Could not equip the firesuit.")
	TEST_ASSERT(body.equip_to_slot_if_possible(helmet, ITEM_SLOT_HEAD), "Could not equip the fire helmet.")
	burn_for(body, 120)
	TEST_ASSERT_EQUAL(body.cremation_stage, NONE, "The fully fire-protected corpse burned.")

	body.dropItemToGround(suit)
	burn_for(body, 119)
	TEST_ASSERT(!HAS_TRAIT(body, TRAIT_HUSK) && body.cremation_stage == NONE, "The burning corpse husked before two minutes.")
	burn_for(body, 1)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_HUSK, "The burning corpse did not become a husk.")
	TEST_ASSERT(HAS_TRAIT_FROM(body, TRAIT_HUSK, BURN), "The first stage did not apply the burn husk trait.")
	burn_for(body, 90)
	body.extinguish_mob()
	body.set_fire_stacks(20)
	var/datum/status_effect/fire_handler/fire_stacks/fire = body.has_status_effect(/datum/status_effect/fire_handler/fire_stacks)
	fire.tick(180)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_HUSK, "The extinguished corpse continued burning.")
	body.ignite_mob()
	burn_for(body, 89)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_HUSK, "The husk charred before five minutes of active fire.")
	burn_for(body, 1)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_CHARRED, "The husk failed to char after five total minutes across two fires.")
	var/list/charred = body_icon_states(body)
	TEST_ASSERT(charred["skeleton_chest"] && charred["skeleton_l_hand"] && !charred["skeleton_head"], "The charred stage did not expose only part of the skeleton.")
	burn_for(body, 299)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_CHARRED, "The skull was exposed before ten minutes.")
	burn_for(body, 1)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_SKELETON, "The charred corpse did not become a skeleton at ten minutes.")
	var/list/skeleton = body_icon_states(body)
	TEST_ASSERT(skeleton["skeleton_head"], "The skeleton still has a flesh-covered head.")
	body.extinguish_mob()
	var/datum/reagent/medicine/rezadone/treatment = allocate(/datum/reagent/medicine/rezadone)
	treatment.expose_mob(body, TOUCH, 5)
	var/list/healed = body_icon_states(body)
	TEST_ASSERT(body.cremation_stage == NONE && !healed["skeleton_head"], "Treating the burn husk did not clear its skeletal appearance.")
	// A brief, extinguished fire must not suppress new damage from a separate source.
	body.set_fire_stacks(20)
	body.ignite_mob()
	burn_for(body, 1)
	body.extinguish_mob()
	body.adjust_fire_loss(1000)
	TEST_ASSERT(HAS_TRAIT_FROM(body, TRAIT_HUSK, BURN), "Severe burn damage outside a fire no longer husks a corpse.")
	body.set_fire_stacks(20)
	body.ignite_mob()
	burn_for(body, 179)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_HUSK, "A pre-existing burn husk charred before another three minutes of fire.")
	burn_for(body, 1)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_CHARRED, "A pre-existing burn husk did not start at the two-minute mark.")
	burn_for(body, 300)
	burn_for(body, 119)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_SKELETON, "The skeleton turned to ash before twelve minutes.")
	burn_for(body, 1)
	TEST_ASSERT_EQUAL(body.cremation_stage, CREMATION_ASH, "The skeleton did not turn to ash at twelve minutes.")
	TEST_ASSERT_EQUAL(body.loc, fire_tile, "The burning corpse left the test floor before dusting.")
	wait_for_dust(body)
	TEST_ASSERT(QDELETED(body), "The burned body remained after the dust animation.")
	TEST_ASSERT_EQUAL(helmet.loc, fire_tile, "The surviving fire helmet was lost or moved.")
	TEST_ASSERT_NOTNULL(locate(/obj/effect/decal/cleanable/ash) in fire_tile, "The burned body left no ash on its floor.")

	var/turf/test_tile = get_step(run_loc_floor_top_right, WEST)
	original_floor_type = test_tile.type
	lava = test_tile.ChangeTurf(/turf/open/lava/airless, flags = CHANGETURF_IGNORE_AIR)
	lava_body.death()
	lava_body.forceMove(lava)
	TEST_ASSERT(lava.air.moles[/datum/gas/oxygen] < 1, "The airless lava fixture has enough oxygen for an ordinary fire.")
	for(var/tick in 1 to 20)
		lava.process(2)
	TEST_ASSERT(lava_body.get_fire_loss() > lava_body.maxHealth + lava_body.get_bodypart(BODY_ZONE_CHEST).max_damage, "The lava failed to inflict enough damage to exercise ordinary damage-based husking.")
	lava.process(79)
	TEST_ASSERT(!HAS_TRAIT(lava_body, TRAIT_HUSK) && lava_body.cremation_stage == NONE, "Direct lava damage bypassed the two-minute husking threshold.")
	lava_body.forceMove(run_loc_floor_top_right)
	lava_body.extinguish_mob()
	lava_body.updatehealth()
	TEST_ASSERT(!HAS_TRAIT(lava_body, TRAIT_HUSK), "Recalculating old burns after rescue bypassed the paused timer.")
	lava_body.forceMove(lava)
	lava.process(1)
	TEST_ASSERT_EQUAL(lava_body.cremation_stage, CREMATION_HUSK, "Airless lava did not husk the body at two minutes.")
	lava.air.set_gas(/datum/gas/oxygen, 20)
	fire = lava_body.has_status_effect(/datum/status_effect/fire_handler/fire_stacks)
	TEST_ASSERT(lava_body.on_fire, "The exposed corpse is not burning on oxygenated lava.")
	fire.tick(90)
	lava.process(90)
	TEST_ASSERT_EQUAL(lava_body.cremation_stage, CREMATION_HUSK, "Lava and atmospheric fire counted the same 90 seconds twice.")
	lava.process(90)
	TEST_ASSERT_EQUAL(lava_body.cremation_stage, CREMATION_CHARRED, "Lava did not char the husk at five minutes.")
	lava.process(300)
	TEST_ASSERT_EQUAL(lava_body.cremation_stage, CREMATION_SKELETON, "The charred corpse did not become a skeleton in lava.")
	lava.process(120)
	TEST_ASSERT_EQUAL(lava_body.cremation_stage, CREMATION_ASH, "Lava did not consume the skeleton.")
	// Equalize pressure before yielding so the test atmosphere cannot push the corpse off the lava.
	lava.copy_air_with_tile(run_loc_floor_top_right)
	wait_for_dust(lava_body)
	TEST_ASSERT(QDELETED(lava_body), "The lava corpse remained after the dust animation.")
	var/obj/effect/decal/cleanable/ash/ashes = locate() in lava
	TEST_ASSERT_NOTNULL(ashes, "The body left no ash on the lava.")
	TEST_ASSERT(!lava.burn_stuff(ashes) && !QDELETED(ashes), "The final ash burned or kept the lava processing.")
